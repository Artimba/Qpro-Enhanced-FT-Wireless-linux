{
  "jsonid": "input_profile",
  "controller_type": "oculus_touch",
  "device_class": "TrackedDeviceClass_Controller",
  "resource_root": "qpro_controller",
  "driver_name": "qpro_controller",
  "legacy_binding": "{oculus}/input/legacy_bindings_touch.json",
  "input_bindingui_mode": "controller_handed",
  "input_bindingui_left": { "image": "{oculus}/icons/oculus_touch_left.svg" },
  "input_bindingui_right": { "image": "{oculus}/icons/oculus_touch_right.svg" },
  "input_source": {
    "/input/system": { "type": "button", "side": "left", "click": true, "touch": true, "order": 0 },
    "/input/trigger": { "type": "trigger", "value": true, "touch": true, "order": 1 },
    "/input/joystick": { "type": "joystick", "click": true, "touch": true, "order": 2 },
    "/input/grip": { "type": "trigger", "value": true, "touch": true, "order": 3 },
    "/input/x": { "type": "button", "side": "left", "click": true, "touch": true, "order": 4 },
    "/input/a": { "type": "button", "side": "right", "click": true, "touch": true, "order": 4 },
    "/input/y": { "type": "button", "side": "left", "click": true, "touch": true, "order": 5 },
    "/input/b": { "type": "button", "side": "right", "click": true, "touch": true, "order": 5 },
    "/input/thumbrest": { "type": "button", "touch": true },
    "/input/trackpad": { "type": "trackpad", "touch": true, "force": true, "click": true, "order": 6 },
    "/input/skeleton/left": { "type": "skeleton", "side": "left", "skeleton": "/skeleton/hand/left" },
    "/input/skeleton/right": { "type": "skeleton", "side": "right", "skeleton": "/skeleton/hand/right" },
    "/output/haptic": { "type": "vibration" },
    "/pose/raw": { "type": "pose" },
    "/pose/base": { "type": "pose" },
    "/pose/handgrip": { "type": "pose" },
    "/pose/tip": { "type": "pose" },
    "/pose/openxr_aim": { "type": "pose" },
    "/pose/openxr_grip": { "type": "pose" }
  }
}
